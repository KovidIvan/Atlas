# Telegram Bot (получить у @BotFather). Если оставить пустым — запустится только Web / Mini App / Админка.
BOT_TOKEN=

# Публичный HTTPS URL для Telegram Mini App (для локального теста — https-туннель cloudflared/ngrok или оставить пустым)
APP_BASE_URL=http://127.0.0.1:8000

# Хост и порт веб-сервера
HOST=127.0.0.1
PORT=8000

# Токен доступа к мини-кабинету международного отдела вуза (/admin)
ADMIN_TOKEN=atlas-vsu-2026

# Настройки LLM (OpenAI-совместимый API: OpenRouter, Gemini, OpenAI, DeepSeek или локальная Ollama)
# Пример для локальной суверенной модели (0 байт за пределы РБ):
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b
# LLM_VISION_MODEL=qwen2.5vl:7b
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_VISION_MODEL=gpt-4o-mini

# Интервалы фоновых проверок (в минутах)
NLA_CHECK_INTERVAL_MIN=360
REMINDER_CHECK_INTERVAL_MIN=60
