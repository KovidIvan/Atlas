# Telegram Bot (получить у @BotFather). Если оставить пустым — работает Web / PWA / Админка.
BOT_TOKEN=

# Публичный HTTPS URL для Telegram Mini App
APP_BASE_URL=http://127.0.0.1:8005

# Хост и порт веб-сервера
HOST=0.0.0.0
PORT=8005

# Токен доступа к кабинету международного отдела вуза (/admin)
ADMIN_TOKEN=atlas-vsu-2026

# === НАСТРОЙКИ ИИ (OpenAI-совместимый API) ===
# Вариант 1 (Рекомендуется — БЕСПЛАТНО без карты, мгновенный ответ + фото вывесок): Groq
# Ключ за 30 сек: https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_VISION_MODEL=qwen/qwen3.8-27b

# Вариант 2 (БЕСПЛАТНО без карты — Google AI Studio, текст + фото):
# Ключ: https://aistudio.google.com/apikey
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash
# LLM_VISION_MODEL=gemini-2.5-flash

# Вариант 3 (БЕСПЛАТНО без карты и без VPN — OpenRouter Free Auto-Router):
# Ключ: https://openrouter.ai/keys
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openrouter/free
# LLM_VISION_MODEL=openrouter/free

# Вариант 4 (Суверенный контур внутри РБ — локальная Ollama, 0 байт наружу):
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b
# LLM_VISION_MODEL=qwen2.5vl:7b

# Интервалы фоновых проверок (в минутах)
NLA_CHECK_INTERVAL_MIN=360
REMINDER_CHECK_INTERVAL_MIN=60
